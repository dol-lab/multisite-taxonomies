{
  "name": "harvardchanschool/multisite_taxonomies",
  "type": "wordpress-plugin",
  "description": "",
  "homepage": "https://github.com/HarvardChanSchool/multisite-taxonomies",
  "authors": [{
      "name": "HSPH Webteam",
      "email": "webteam@hsph.harvard.edu",
      "homepage": "http://www.hsph.harvard.edu/information-technology/"
  }],
  "repositories": [{
      "type": "vcs",
      "url": "https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards"
  }],
  "require": {
  	"composer/installers": "~2.0"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "1.*",
    "phpunit/phpunit": "9.*"
  },
  "scripts": {
    "test": "composer install-test && phpunit -c multisite.xml",
    "install-test": "./bin/install-wp-tests.sh multitaxo_test root devpw 127.0.0.1 latest"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
